# LinkedIn Credentials
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_password_here

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Database Configuration
DATABASE_URL=sqlite:///data/springboard.db

# Logging
LOG_LEVEL=INFO

# Automation Limits
MAX_APPLICATIONS_PER_DAY=20
SCRAPING_DELAY=5

# Dice Credentials (optional)
DICE_EMAIL=
DICE_PASSWORD=

# Indeed Credentials (optional - not required for search)
INDEED_EMAIL=
INDEED_PASSWORD=

# Monster Credentials (optional)
MONSTER_EMAIL=
MONSTER_PASSWORD=

# Handshake Credentials (optional)
HANDSHAKE_EMAIL=
HANDSHAKE_PASSWORD=
